OOONO_CLIENT_ID=
OOONO_CLIENT_SECRET=

# Snowflake: nonsecret account settings; configure locally.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=OOONO_WH
SNOWFLAKE_DATABASE=OOONO_CASE
SNOWFLAKE_SCHEMA=RAW
# SNOWFLAKE_JWT, externalbrowser (configured SSO), or username_password_mfa.
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
# Encrypted PKCS8 private key path, outside version control.
SNOWFLAKE_PRIVATE_KEY_FILE=
# Leave unset to enter the key passphrase securely at the terminal.
SNOWFLAKE_PRIVATE_KEY_PASSWORD=
DBT_SNOWFLAKE_ROLE=OOONO_DBT
